    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/allow.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/allow.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
